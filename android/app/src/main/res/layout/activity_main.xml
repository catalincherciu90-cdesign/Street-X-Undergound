<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b1310"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- TOP BAR: titlu + iconiță profil (dreapta sus) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="70dp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/ic_logo"
                    android:contentDescription="@string/app_name" />
            </LinearLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivProfile"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                android:background="#173a2a"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:strokeColor="#2fe08a"
                app:strokeWidth="2dp" />
        </LinearLayout>

        <!-- FORMULAR LOGIN -->
        <LinearLayout
            android:id="@+id/loginBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp">

            <TextView style="@style/Lbl" android:text="Utilizator" />
            <EditText
                android:id="@+id/etUser"
                style="@style/Inp"
                android:hint="utilizatorul primit de la dispecer"
                android:inputType="text"
                android:autofillHints="username" />

            <TextView style="@style/Lbl" android:text="Parolă" />
            <EditText
                android:id="@+id/etPass"
                style="@style/Inp"
                android:hint="parola"
                android:inputType="textPassword"
                android:autofillHints="password" />

            <TextView style="@style/Lbl" android:text="Interval trimitere (secunde)" />
            <EditText
                android:id="@+id/etInterval"
                style="@style/Inp"
                android:text="30"
                android:inputType="number" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="#2fe08a"
                android:textColor="#06231a"
                android:text="Conectează" />
        </LinearLayout>

        <!-- ECRAN PRINCIPAL (după login) -->
        <LinearLayout
            android:id="@+id/onlineBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="20dp"
                android:text="○ OFFLINE"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnToggle"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:backgroundTint="#2fe08a"
                android:textColor="#06231a"
                android:textSize="24sp"
                android:textStyle="bold"
                android:text="GO ONLINE" />

            <Button
                android:id="@+id/btnCourses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="🧾 Cursele mele" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:textColor="#6e7681"
                android:textSize="12sp"
                android:text="La pornire alege „Permite tot timpul” pentru locație, ca urmărirea să meargă și cu telefonul blocat. Apasă iconița din dreapta sus pentru cont / deconectare." />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
